    {
      "name": "pcb-svg",
      "status": "public",
      "design_doc": "docs/design/cli/pcb-svg.html",
      "summary": "Render composable PCB SVG layers, solder-mask film, native component illustrations and autodoc-fitted assembly designators, using --workers (default 4) for STEP tessellation and component HLR/illustration, Fast projection, shared contexts and persistent model/artwork reuse controlled by --cache-dir/--no-cache. Successful cached placements bypass mesh loading. Optional --timings JSON records layer/view wall times and cache outcomes.",
      "surface_ref": "docs/design/cli/pcb-svg.html"
