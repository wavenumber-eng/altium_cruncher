{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavenumber-eng/altium_cruncher/docs/contracts/project_skeleton_config.v1.schema.json",
  "title": "Altium Cruncher Project Skeleton Config V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "project", "schematics"],
  "properties": {
    "schema": {
      "const": "wn.altium_cruncher.project_skeleton.v1"
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": ["file"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      }
    },
    "schematics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["file"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "sheet_style": {"type": ["string", "integer"]},
          "template": {"type": "string"},
          "apply_template_visual_sheet_settings": {"type": "boolean"},
          "custom_sheet_mils": {
            "type": "object",
            "additionalProperties": true,
            "required": ["width", "height"],
            "properties": {
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "pcb": {
      "type": "object",
      "additionalProperties": true,
      "required": ["file"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "board_outline_mils": {
          "type": "object",
          "additionalProperties": true,
          "required": ["left", "bottom", "right", "top"],
          "properties": {
            "left": {"type": "number"},
            "bottom": {"type": "number"},
            "right": {"type": "number"},
            "top": {"type": "number"}
          }
        },
        "layer_stack": {
          "type": "object",
          "additionalProperties": true,
          "required": ["mode", "copper_layers"],
          "properties": {
            "mode": {"const": "generated_rigid"},
            "name": {"type": "string"},
            "copper_layers": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["name"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "thickness_mils": {"type": "number"}
                }
              }
            },
            "dielectrics_between": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "material": {"type": "string"},
                  "thickness_mils": {"type": ["number", "null"]},
                  "dk": {"type": ["number", "null"]},
                  "type_code": {"type": ["integer", "null"]}
                }
              }
            }
          }
        },
        "layer_stack_template": {"type": "string"},
        "mechanical_layer_profile": {
          "enum": ["none", "standard_component_pairs"]
        }
      }
    }
  }
}
