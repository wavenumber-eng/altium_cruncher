{
  // Draft next-generation config. This is human/GUI-authored mate-board intent.
  // It is not the current implemented v1 contract yet. The planner should
  // resolve coordinates, nets, source side, and source geometry from the DUT.
  "schema": "wn.pcb_cruncher.mate_config.a0",

  "source": {
    // Copy the DUT project into input/cricket-node before running.
    "board": "input/cricket-node/11-10028__cricket-node-hw__B.PrjPcb",
    // Optional when a project has more than one PCB document.
    "pcbdoc": null
  },

  "output": {
    // The first backend is Altium. The config concepts should remain portable.
    "backend": "altium",
    "output_dir": "output/cricket-node-mate",
    "project_name": "cricket_node_mate",
    "schematic_sheet_style": "D",
    // Keep source and output board origins aligned for projected geometry and
    // bottom-layer STEP alignment artifacts.
    "origin": "preserve_source",
    // The generated project skeleton currently supports rectangular output
    // outlines. This example leaves extra room for labels/breakout features on
    // the right side while keeping a smaller keepaway on the other sides. Use
    // "source_bounds" to match the DUT bounds.
    "board_outline": {
      "mode": "source_bounds_with_margin",
      "margin_mils": {
        "left": 500,
        "bottom": 500,
        "right": 3000,
        "top": 500
      }
    },
    "overwrite": true
  },

  "known_parts": {
    // For now this is the node-test-array cache. Longer term this likely points
    // at ALX CAD part-library-backed metadata.
    "manifest": "known-parts/mate-known-parts.json"
  },

  "validation": {
    // The planner infers source side from selected objects and rejects mixed
    // top/bottom SMT-like selections.
    "source_side": "infer_single_side",
    // Through-hole / 1:1 projection workflows may be side agnostic.
    "allow_side_agnostic_through_hole": true
  },

  "projections": [
    {
      "id": "test_points",
      "source": {
        "object": "component",
        // Accepts compact expressions such as "TP*", "TP1-5", or
        // "TP1-5, U12".
        "designators": "TP1-27"
      },
      "actions": [
        {
          "kind": "mate_component",
          "part": "test_point_pogo"
        },
        {
          "kind": "reference_graphics",
          "shape": "source_pad_outline",
          "layer": "MECHANICAL_1",
          "style": {
            // Default reference graphics trace one expanded source-pad outline.
            // Use "double_outline" or outline_count > 1 for multiple outlines.
            "mode": "outline",
            "outline_count": 1,
            // Clearance is measured from the source pad edge to the inside
            // edge of the outline stroke. With clearance 0, the inside edge
            // just touches the pad.
            "clearance_mils": 10,
            "stroke_width_mils": 10
          }
        },
        {
          "kind": "label",
          "text": "source_net",
          "placement": {
            // Board-edge label placement creates a neat column inside the
            // expanded output outline. Use board_left to move the column.
            "side": "board_right",
            "offset_mils": [250, 250],
            "box_size_mils": [450, 70],
            "row_spacing_mils": 90,
            "column_spacing_mils": 80,
            "auto_width_padding_mils": 80
          },
          "style": {
            "height_mils": 65,
            "layer": "TOP_OVERLAY",
            "font_kind": "truetype",
            "font_name": "Arial",
            "bold": true,
            "stroke_width_mils": 10,
            "text_justification": "RIGHT_TOP"
          }
        }
      ]
    },
    {
      "id": "mounts",
      "source": {
        "object": "component",
        "designators": "M1-4"
      },
      "actions": [
        {
          "kind": "mate_component",
          "part": "m25_smt_standoff"
        },
        {
          "kind": "reference_graphics",
          "shape": "source_pad_outline",
          "layer": "MECHANICAL_1",
          "style": {
            "mode": "outline",
            "outline_count": 1,
            "clearance_mils": 10,
            "stroke_width_mils": 10
          }
        }
      ]
    },
    {
      "id": "alignment_pins",
      "source": {
        "object": "free_pad",
        "hole_size_mils": {
          "min": 75,
          "max": 85
        },
        "plated": false
      },
      "actions": [
        {
          "kind": "mate_component",
          "part": "alignment_pin_2mm_npth"
        },
        {
          "kind": "reference_graphics",
          "shape": "source_pad_outline",
          "layer": "MECHANICAL_1",
          "style": {
            "mode": "outline",
            "outline_count": 1,
            "clearance_mils": 10,
            "stroke_width_mils": 10
          }
        },
        {
          "kind": "label",
          "text": "source_net",
          "placement": {
            "side": "board_right",
            "offset_mils": [250, 250],
            "box_size_mils": [450, 70],
            "row_spacing_mils": 90,
            "column_spacing_mils": 80,
            "auto_width_padding_mils": 80
          },
          "style": {
            "height_mils": 65,
            "layer": "TOP_OVERLAY",
            "font_kind": "truetype",
            "font_name": "Arial",
            "bold": true,
            "stroke_width_mils": 10,
            "text_justification": "RIGHT_TOP"
          }
        }
      ]
    }
  ],

  "pcb_designators": {
    "enabled": true,
    "placement": "above_component",
    // Keep generated mate component designators compact, above the target
    // feature, and editable after the board is opened in Altium.
    "offset_mils": [0, 10],
    "width_factor": 0.6,
    "style": {
      "height_mils": 40,
      "layer": "TOP_OVERLAY",
      "font_kind": "truetype",
      "font_name": "Arial",
      "bold": true,
      "stroke_width_mils": 8
    }
  },

  "board_projection": {
    "outline": {
      "graphics": {
        "enabled": true,
        "layer": "TOP_OVERLAY",
        "stroke_width_mils": 8
      }
    },
    "cutouts": {
      "graphics": {
        "enabled": true,
        "layer": "MECHANICAL_1",
        "stroke_width_mils": 8
      },
      "actual_cutouts": true
    }
  },

  "artifacts": {
    "pcb_layer_step": {
      "enabled": true,
      "source_layer": "bottom",
      // Keep local Z=0 on the copper mid-plane. z_mm is still the body bottom
      // plane, so this is -thickness_mm / 2 for 0.035 mm copper.
      "thickness_mm": 0.035,
      "z_mm": -0.0175,
      "features": {
        "tracks": {
          "enabled": true,
          "color": "#B87333"
        },
        "polygons": {
          "enabled": true,
          "color": "#7A8F2A"
        },
        "arcs": true,
        "fills": true,
        "regions": true,
        "vias": true,
        "component_pads": true,
        "free_pads": true
      },
      "insert_in_output": {
        "enabled": true,
        "z_mm": 8.5,
        "layer": "MECHANICAL_13",
        "side": "TOP"
      },
      "highlights": [
        {
          "projection": "test_points",
          "color": "#FF0000"
        }
      ]
    }
  }
}
