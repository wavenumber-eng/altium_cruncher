{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavenumber-eng/altium_cruncher/docs/contracts/project_skeleton_config.a0.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "altium_cruncher.project_skeleton.a0",
      "description": "Project skeleton config contract id."
    },
    "project": {
      "$ref": "#/$defs/ProjectOutput",
      "description": "PrjPcb output and project-level parameters."
    },
    "schematics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SchdocChild"
      },
      "description": "SchDoc sheets to create and add to the project. Empty creates no sheets."
    },
    "pcb": {
      "anyOf": [
        {
          "$ref": "#/$defs/PcbdocChild"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional PcbDoc output; null creates no board."
    }
  },
  "required": [
    "schema",
    "project",
    "schematics"
  ],
  "allOf": [
    {
      "$ref": "#/$defs/RecordUnknown"
    }
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "$defs": {
    "ProjectOutput": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/NonemptyString",
          "description": "PrjPcb file to create, relative to this config file unless absolute."
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Project display name; omission, null or empty derives it from the file."
        },
        "parameters": {
          "$ref": "#/$defs/RecordUnknown",
          "description": "Project parameters; the Python adapter converts authored values to strings."
        }
      },
      "required": [
        "file"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "SchdocChild": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/NonemptyString",
          "description": "SchDoc file to create, relative to this config file unless absolute."
        },
        "sheet_style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Altium SheetStyle enum name or native integer id. Falsy input uses D.",
          "default": "D"
        },
        "template": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonemptyString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional SchDot template file to copy settings from."
        },
        "apply_template_visual_sheet_settings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {}
            },
            {
              "$ref": "#/$defs/RecordUnknown"
            }
          ],
          "description": "Whether to copy visual sheet settings from the template; legacy JSON truthiness is preserved. Prefer true or false.",
          "default": false
        },
        "custom_sheet_mils": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomSheetMils"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional explicit sheet size in mils."
        }
      },
      "required": [
        "file"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "PcbdocChild": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/NonemptyString",
          "description": "PcbDoc file to create, relative to this config file unless absolute."
        },
        "board_outline_mils": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoardOutlineMils"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional rectangular board outline in mils."
        },
        "layer_stack": {
          "anyOf": [
            {
              "$ref": "#/$defs/RigidLayerStack"
            },
            {
              "type": "null"
            }
          ],
          "description": "Generated rigid stack; use only one layer-stack input."
        },
        "layer_stack_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Named layer-stack template; defaults to 2-layer when no stack input is supplied.",
          "default": "2-layer"
        },
        "stackupx_file": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonemptyString"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional .stackupx path to import as the PcbDoc layer-stack document."
        },
        "mechanical_layer_profile": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "const": "none"
                },
                {
                  "type": "string",
                  "const": ""
                },
                {
                  "type": "string",
                  "const": "standard_component_pairs"
                },
                {
                  "type": "string",
                  "const": "standard-component-pairs"
                },
                {
                  "type": "string",
                  "const": "v7_mechanical_53"
                },
                {
                  "type": "string",
                  "const": "v7-mechanical-53"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "string",
              "pattern": "^\\s*(?:[nN][oO][nN][eE]||[sS][tT][aA][nN][dD][aA][rR][dD]_[cC][oO][mM][pP][oO][nN][eE][nN][tT]_[pP][aA][iI][rR][sS]|[sS][tT][aA][nN][dD][aA][rR][dD]-[cC][oO][mM][pP][oO][nN][eE][nN][tT]-[pP][aA][iI][rR][sS]|[vV]7_[mM][eE][cC][hH][aA][nN][iI][cC][aA][lL]_53|[vV]7-[mM][eE][cC][hH][aA][nN][iI][cC][aA][lL]-53)\\s*$"
            }
          ],
          "description": "Optional profile; case, surrounding whitespace and hyphen aliases are accepted.",
          "default": "none",
          "x-acr-input": "enum"
        },
        "mechanical_layers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MechanicalLayer"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "mechanical_layer_pairs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/GroupedMechanicalPair"
                  },
                  {
                    "$ref": "#/$defs/FlatMechanicalPair"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "mechanical_layer_kinds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MechanicalKind"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "file"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "RecordUnknown": {
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {}
    },
    "NonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "CustomSheetMils": {
      "type": "object",
      "properties": {
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "Custom sheet width in mils."
        },
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "Custom sheet height in mils."
        }
      },
      "required": [
        "width",
        "height"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "BoardOutlineMils": {
      "type": "object",
      "properties": {
        "left": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "default": 0
        },
        "bottom": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "default": 0
        },
        "right": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "default": 3000
        },
        "top": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "default": 2000
        }
      },
      "required": [
        "left",
        "bottom",
        "right",
        "top"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "RigidLayerStack": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "generated_rigid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Layer-stack generation mode. Omission or null uses generated_rigid.",
          "default": "generated_rigid"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "copper_layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CopperLayer"
          },
          "minItems": 2,
          "description": "Copper layers in top-to-bottom order."
        },
        "dielectrics_between": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DielectricLayer"
          },
          "description": "Dielectric layers between adjacent copper layers."
        }
      },
      "required": [
        "copper_layers",
        "dielectrics_between"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "MechanicalLayer": {
      "type": "object",
      "properties": {
        "layer": {
          "$ref": "#/$defs/NonemptyString"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonemptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {}
            },
            {
              "$ref": "#/$defs/RecordUnknown"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonemptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "layer"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "GroupedMechanicalPair": {
      "type": "object",
      "properties": {
        "top": {
          "$ref": "#/$defs/MechanicalPairSide"
        },
        "bottom": {
          "$ref": "#/$defs/MechanicalPairSide"
        }
      },
      "required": [
        "top",
        "bottom"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "FlatMechanicalPair": {
      "type": "object",
      "properties": {
        "layer_1": {
          "$ref": "#/$defs/NonemptyString"
        },
        "layer_2": {
          "$ref": "#/$defs/NonemptyString"
        },
        "pair_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "top": {
          "not": {}
        },
        "bottom": {
          "not": {}
        }
      },
      "required": [
        "layer_1",
        "layer_2"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "MechanicalKind": {
      "type": "object",
      "properties": {
        "layer": {
          "$ref": "#/$defs/NonemptyString"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonemptyString"
            },
            {
              "type": "integer"
            }
          ]
        }
      },
      "required": [
        "layer",
        "kind"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "CopperLayer": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/NonemptyString",
          "description": "Copper layer display name."
        },
        "copper_thickness_mils": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Copper thickness in mils."
        },
        "thickness_mils": {
          "description": "Historical extension field; ignored by creation. Use copper_thickness_mils."
        },
        "component_placement": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional native component-placement enum id."
        },
        "copper_orientation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional native copper-orientation enum id."
        }
      },
      "required": [
        "name"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "DielectricLayer": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/NonemptyString"
        },
        "material": {
          "$ref": "#/$defs/NonemptyString"
        },
        "thickness_mils": {
          "type": "number"
        },
        "dielectric_constant": {
          "type": "number"
        },
        "dk": {
          "description": "Historical extension field; ignored by creation. Use dielectric_constant."
        },
        "dielectric_type": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "type_code": {
          "description": "Historical extension field; ignored by creation. Use dielectric_type."
        },
        "loss_tangent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "material",
        "thickness_mils",
        "dielectric_constant"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "MechanicalPairSide": {
      "type": "object",
      "properties": {
        "layer": {
          "$ref": "#/$defs/NonemptyString"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonemptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {}
            },
            {
              "$ref": "#/$defs/RecordUnknown"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/NonemptyString"
        }
      },
      "required": [
        "layer",
        "kind"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/RecordUnknown"
        }
      ],
      "unevaluatedProperties": {
        "not": {}
      }
    }
  },
  "$comment": "Generated from src/tsp/altium_cruncher/config/creation.tsp. Do not edit."
}
