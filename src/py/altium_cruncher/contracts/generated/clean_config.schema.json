{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavenumber-eng/altium_cruncher/docs/contracts/clean_config.a0.schema.json",
  "anyOf": [
    {
      "$ref": "#/$defs/SchematicCleanConfig"
    },
    {
      "$ref": "#/$defs/PcblibCleanConfig"
    }
  ],
  "description": "JSON/JSONC configuration contract for schematic, schematic-library, and PCB-library clean workflows.",
  "title": "Altium Cruncher Clean Config",
  "$defs": {
    "SchematicCleanConfig": {
      "type": "object",
      "properties": {
        "schema": {
          "anyOf": [
            {
              "type": "string",
              "const": "altium_cruncher.clean.config.a0"
            },
            {
              "type": "null"
            }
          ]
        },
        "normalize_pin_fonts": {
          "$ref": "#/$defs/PinFonts"
        },
        "normalize_symbol_body_rectangles": {
          "$ref": "#/$defs/SymbolBodyRectangles"
        },
        "normalize_power_symbols": {
          "$ref": "#/$defs/FontAndColorRule"
        },
        "normalize_net_labels": {
          "$ref": "#/$defs/FontAndColorRule"
        },
        "normalize_component_designators": {
          "$ref": "#/$defs/ComponentFontRule"
        },
        "normalize_component_parameters": {
          "$ref": "#/$defs/ComponentFontRule"
        },
        "normalize_component_free_text": {
          "$ref": "#/$defs/ComponentFreeText"
        },
        "normalize_wires": {
          "$ref": "#/$defs/ColorRule"
        },
        "normalize_no_erc": {
          "$ref": "#/$defs/NoErcRule"
        },
        "normalize_sheet_style": {
          "$ref": "#/$defs/SheetStyle"
        },
        "normalize_symbol_internal_graphics_monochrome": {
          "$ref": "#/$defs/InternalGraphics"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "PcblibCleanConfig": {
      "type": "object",
      "properties": {
        "schema": {
          "anyOf": [
            {
              "type": "string",
              "const": "altium_cruncher.pcblib.clean.config.a0"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "anyOf": [
            {
              "type": "string",
              "const": "default"
            },
            {
              "type": "string",
              "const": "raw"
            }
          ]
        },
        "remove_mechanical_primitives": {
          "$ref": "#/$defs/PcblibMechanicalPrimitives"
        },
        "remove_text_strings": {
          "$ref": "#/$defs/PcblibTextStrings"
        },
        "remove_regions": {
          "$ref": "#/$defs/PcblibRegions"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "PinFonts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name_font": {
          "$ref": "#/$defs/FontSpec"
        },
        "name": {
          "$ref": "#/$defs/FontSpec"
        },
        "designator_font": {
          "$ref": "#/$defs/FontSpec"
        },
        "designator": {
          "$ref": "#/$defs/FontSpec"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "SymbolBodyRectangles": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "min_width_mils": {
          "type": "number",
          "minimum": 0
        },
        "min_height_mils": {
          "type": "number",
          "minimum": 0
        },
        "outline_color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "outline_color": {
          "$ref": "#/$defs/ColorValue"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        },
        "line_width": {
          "$ref": "#/$defs/LineWidth"
        },
        "fill_color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "fill_color": {
          "$ref": "#/$defs/ColorValue"
        },
        "area_color": {
          "$ref": "#/$defs/ColorValue"
        },
        "is_solid": {
          "type": "boolean"
        },
        "transparent": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "FontAndColorRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        },
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "size_pt": {
          "type": "integer",
          "minimum": 1
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "font": {
          "$ref": "#/$defs/FontSpec"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ComponentFontRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "font": {
          "$ref": "#/$defs/FontSpec"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ComponentFreeText": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ColorRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "NoErcRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        },
        "symbol": {
          "$ref": "#/$defs/NoErcRuleSymbol"
        },
        "style": {
          "$ref": "#/$defs/NoErcRuleStyle"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "SheetStyle": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "line_color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "line_color": {
          "$ref": "#/$defs/ColorValue"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        },
        "area_color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "area_color": {
          "$ref": "#/$defs/ColorValue"
        },
        "document_font": {
          "$ref": "#/$defs/FontSpec"
        },
        "font": {
          "$ref": "#/$defs/FontSpec"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "InternalGraphics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "saturation": {
          "type": "number",
          "maximum": 1,
          "minimum": 0
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "PcblibMechanicalPrimitives": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "primitive_types": {
          "$ref": "#/$defs/StringList"
        },
        "layers": {
          "$ref": "#/$defs/StringList",
          "description": "Layer name filters. Accepts legacy PcbLayer names, display names such as 'Mechanical 17', and V7 semantic tokens such as 'MECHANICAL17' when the installed altium-monkey exposes the V7-aware layer API; token and display forms match the same layer."
        },
        "preserve_regions": {
          "type": "boolean"
        },
        "preserve_component_bodies": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "PcblibTextStrings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "layers": {
          "$ref": "#/$defs/StringList",
          "description": "Layer name filters. Accepts legacy PcbLayer names, display names such as 'Mechanical 17', and V7 semantic tokens such as 'MECHANICAL17' when the installed altium-monkey exposes the V7-aware layer API; token and display forms match the same layer."
        },
        "match": {
          "anyOf": [
            {
              "type": "string",
              "const": "all"
            },
            {
              "type": "string",
              "const": "regex"
            },
            {
              "type": "string",
              "const": "contains"
            },
            {
              "type": "string",
              "const": "exact"
            }
          ]
        },
        "patterns": {
          "$ref": "#/$defs/StringList"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "PcblibRegions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "layers": {
          "$ref": "#/$defs/StringList",
          "description": "Layer name filters. Accepts legacy PcbLayer names, display names such as 'Mechanical 17', and V7 semantic tokens such as 'MECHANICAL17' when the installed altium-monkey exposes the V7-aware layer API; token and display forms match the same layer."
        },
        "preserve_component_linked": {
          "type": "boolean"
        },
        "preserve_model_associated": {
          "type": "boolean"
        },
        "preserve_keepouts": {
          "type": "boolean"
        },
        "preserve_board_cutouts": {
          "type": "boolean"
        },
        "preserve_custom_pad_regions": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "FontSpec": {
      "type": "object",
      "properties": {
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "size_pt": {
          "type": "integer",
          "minimum": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "color_win32": {
          "$ref": "#/$defs/ColorValue"
        },
        "color": {
          "$ref": "#/$defs/ColorValue"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "ColorValue": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "LineWidth": {
      "oneOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "const": "smallest"
            },
            {
              "type": "string",
              "const": "zero"
            },
            {
              "type": "string",
              "const": "small"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "large"
            }
          ]
        },
        {
          "type": "integer"
        }
      ]
    },
    "NoErcRuleSymbol": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "NoErcRuleStyle": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "StringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$comment": "Generated from src/tsp/altium_cruncher/config/clean-config.tsp. Do not edit."
}
