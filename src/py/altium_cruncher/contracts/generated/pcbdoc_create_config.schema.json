            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "const": "standard_component_pairs"
            },
            {
              "type": "string",
              "const": "standard-component-pairs"
            },
            {
              "type": "string",
              "const": "v7_mechanical_53"
            },
            {
              "type": "string",
              "const": "v7-mechanical-53"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "string",
          "pattern": "^\\s*(?:[nN][oO][nN][eE]||[sS][tT][aA][nN][dD][aA][rR][dD]_[cC][oO][mM][pP][oO][nN][eE][nN][tT]_[pP][aA][iI][rR][sS]|[sS][tT][aA][nN][dD][aA][rR][dD]-[cC][oO][mM][pP][oO][nN][eE][nN][tT]-[pP][aA][iI][rR][sS]|[vV]7_[mM][eE][cC][hH][aA][nN][iI][cC][aA][lL]_53|[vV]7-[mM][eE][cC][hH][aA][nN][iI][cC][aA][lL]-53)\\s*$"
        }
      ],
      "description": "Optional profile; case, surrounding whitespace and hyphen aliases are accepted.",
      "default": "none",
      "x-acr-input": "enum"
    },
    "mechanical_layers": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MechanicalLayer"
