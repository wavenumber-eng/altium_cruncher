  `global.styles.assembly_designators.stroke_width_mm`: "Full outline stroke width in board millimetres; 0 disables it. Label fitting is unchanged.",
  `global.styles.board_substrate`: "Bare board fill for BOARD_SUBSTRATE. Place before copper and film; physical bores and scoped cutouts remain open.",
  `global.styles.board_substrate.color`: "Global substrate CSS color override or auto (default) for region-local resolution.",
  `global.styles.board_substrate.rigid_color`: "Rigid-substrate fallback when no authored or saved board-core color exists. Default: #B6A26B.",
  `global.styles.board_substrate.flex_color`: "Flex-substrate fallback when no authored material color exists. Default: #D18B28 (amber polyimide).",
  `global.styles.soldermask_film`: "Region-local solder-mask or coverlay film clipped to the board profile and cutouts.",
  `global.styles.soldermask_film.color`: "Global film CSS color override or auto (default): authored material color, then saved Altium 3D mask color for solder mask, then a surface-class fallback.",
  `global.styles.soldermask_film.coverlay_color`: "Coverlay fallback when no authored material color exists. Default: #D18B28 (amber polyimide).",
  `global.styles.soldermask_film.opacity`: "Film opacity from 0 (transparent) to 1 (opaque, default).",
  `global.styles.silkscreen_surface`: "Surface clipping shared by top/bottom physical silkscreen artwork.",
  `global.styles.silkscreen_surface.clip_mode`: "Silkscreen clipping: none preserves authored overlay; board removes board voids; film also removes film apertures and uncoated regions. Default: none.",
  `global.styles.bend_lines`: "Flat rigid-flex bend-line annotations; these do not fold or deform the board.",
  `global.styles.bend_lines.color`: "Bend-line CSS color. Default: #D97706.",
  `global.styles.bend_lines.opacity`: "Bend-line opacity from 0 (transparent) to 1 (opaque). Default: 0.8.",
  `global.styles.bend_lines.dash_length_mm`: "Bend-line dash length in millimeters. Default: 0.5.",
  `global.styles.bend_lines.dash_gap_mm`: "Gap between bend-line dashes in millimeters. Default: 0.3.",
  `global.styles.bend_lines.extension_mm`: "Absolute distance each endpoint extends beyond the owning-region chord. Default: 1 mm per end.",
