  `global.svg_scale`: "Multiplier for SVG width and height attributes.",
  `global.svg_size_unit`: "Optional SVG size unit suffix, such as mm or px.",
  `global.clean_output`: "Reserved cleanup flag for generated output directories.",
  `global.styles`: "Default style table for physical and synthetic layers.",
  `global.styles.illustration`: "Component illustration enabled, line_width_mm and opacity. Views inherit global values and override only the supplied fields.",
