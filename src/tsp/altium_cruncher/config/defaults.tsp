namespace Wavenumber.AltiumCruncher.Config;

// Defaults are applied by the resolver, never by the authored-config codec.
const configComments = #{
  schema: "PCB SVG config contract id.",
  global: "Global settings applied to layer outputs and composed views.",
  `global.pcbdoc`: "Optional PcbDoc selector when a PrjPcb contains multiple boards.",
  `global.canvas`: "SVG viewBox normalization policy.",
  `global.canvas.bounds`: "Canvas bounds mode. Options: all_geometry, board_outline.",
