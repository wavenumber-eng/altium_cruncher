const styleComments = #{
  enabled: "Enable this rendering rule.",
  color: "SVG color value, usually #RRGGBB.",
  plated_color: "SVG color for plated drill/slot features.",
  non_plated_color: "SVG color for non-plated drill/slot features.",
  outline: "Draw drill/slot boundaries with unfilled centers instead of filled marks.",
  respect_tenting: "Hide plated drill/slot marks covered by solder mask on the rendered side.",
  line_width_mm: "Stroke width in millimeters.",
  line_style: "Stroke style. Options: solid, dashed.",
  dash_length_mm: "Dash length in millimeters when line_style is dashed.",
  hatch: "Enable hatch fill for this layer/style.",
  scope: "Board cutouts used by clipping, film and cutout artwork; interior excludes boundary-touching/outside contours. Options: all, interior.",
  hatch_spacing_mm: "Hatch spacing in millimeters.",
  hatch_angle_deg: "Hatch angle in degrees.",
  hatch_line_width_mm: "Hatch stroke width in millimeters.",
  hatch_color: "Hatch color; omitted uses the cutout outline color.",
  hatch_opacity: "Hatch opacity from 0.0 to 1.0, independent of the outline.",
  outline_opacity: "Cutout outline opacity from 0.0 to 1.0.",
  label: "Cutout label text; an empty string disables labels.",
  label_color: "Label color; omitted uses the cutout outline color.",
  label_opacity: "Cutout label opacity from 0.0 to 1.0.",
  label_max_font_size_mm: "Maximum fitted cutout label font size in millimeters.",
  label_fill_ratio: "Fraction of cutout width/height available to the fitted label (0 to 1).",
  outline_style: "Outline stroke style. Options: solid, dashed.",
  outline_dash_mm: "Dash length in millimeters when outline_style is dashed.",
  outline_width_mm: "Outline stroke width in millimeters.",
  opacity: "Layer opacity from 0.0 to 1.0.",
  dot_diameter_mm: "Pin-1 marker dot diameter in millimeters.",
  min_dot_diameter_mm: "Minimum pin-1 marker dot diameter in millimeters.",
  curve_mode: "Legacy HLR curve serialization mode; Fast always emits polylines. Options: native_arcs, polyline.",
  samples_per_curve: "Polyline sample count when curves are sampled.",
  round_digits: "Decimal places retained in generated SVG path coordinates.",
  include_visible: "Legacy poly/exact visible-edge control; leave true for Fast.",
  include_outline: "Legacy poly/exact silhouette control; leave true for Fast.",
  union_polygons: "Union projected polygons before converting to SVG paths.",
};

